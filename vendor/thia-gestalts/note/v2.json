{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://thia.example/gestalts/note/v2.json",
  "title": "Note",
  "description": "Learner-authored text with optional image attachments and links to related records. Mint an independent UUID at creation.",
  "$ref": "../common/v2.json#/$defs/recordIdentity",
  "required": ["text"],
  "properties": {
    "kind": { "const": "note" },
    "text": { "type": "string", "minLength": 1 },
    "attachments": {
      "type": "array",
      "items": { "$ref": "../common/v2.json#/$defs/imageReference" }
    },
    "related": {
      "type": "array",
      "items": { "$ref": "../common/v2.json#/$defs/recordReference" }
    }
  },
  "unevaluatedProperties": false
}
